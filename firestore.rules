/**
 * @file Firestore Security Rules for e-commerce application.
 *
 * Core Philosophy:
 * This ruleset enforces a combination of public read access for general content (products, categories, banners)
 * and strict user-ownership for private user data (cart, wishlist, orders).  It prioritizes clear access
 * patterns and avoids complex queries within the rules to maintain performance and security.
 *
 * Data Structure:
 * - /products/{productId}: Public product information.
 * - /categories/{categoryId}: Public category information.
 * - /users/{userId}: User profile information, accessible only by the user.
 * - /users/{userId}/orders/{orderId}: Order information, accessible only by the user.
 * - /users/{userId}/orders/{orderId}/orderItems/{orderItemId}: Order items, accessible only by the user.
 * - /users/{userId}/cartItems/{cartItemId}: Cart items, accessible only by the user.
 * - /promoBanners/{promoBannerId}: Public promotional banner information.
 * - /featuredProducts/{featuredProductId}: Public featured product information.
 * - /users/{userId}/wishlistItems/{wishlistItemId}: Wishlist items, accessible only by the user.
 * - /aiRecommendations/{aiRecommendationId}: AI-generated product recommendations. Publicly accessible.
 *
 * Key Security Decisions:
 * - Public read access is granted to products, categories, promo banners and featured products.
 * - User listing is implicitly denied because there is no rule allowing it.
 * - The default security posture for ambiguous relationships is strict owner-only access.
 *
 * Denormalization for Authorization:
 *  - User-specific data (orders, cart items, wishlist items) is stored under the /users/{userId} path
 *    to easily enforce ownership-based access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows read access to product information.
     * @path /products/{productId}
     * @allow (get, list): Any user can read product information.
     * @deny (create, update, delete): No user can create, update, or delete product information through the client.
     * @principle Public read access for product information.
     */
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows read access to category information.
     * @path /categories/{categoryId}
     * @allow (get, list): Any user can read category information.
     * @deny (create, update, delete): No user can create, update, or delete category information through the client.
     * @principle Public read access for category information.
     */
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows a user to read, create, update, and delete their own user profile.
     * @path /users/{userId}
     * @allow (get, create, update, delete): The user with ID {userId} can perform these operations on their own profile.
     * @deny (get, create, update, delete): A user cannot access or modify another user's profile.
     * @principle Enforces user-ownership for user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows a user to read, create, update, and delete their own orders.
     * @path /users/{userId}/orders/{orderId}
     * @allow (get, create, update, delete): The user with ID {userId} can perform these operations on their own orders.
     * @deny (get, create, update, delete): A user cannot access or modify another user's orders.
     * @principle Enforces user-ownership for orders.
     */
    match /users/{userId}/orders/{orderId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows a user to read, create, update, and delete their own order items.
     * @path /users/{userId}/orders/{orderId}/orderItems/{orderItemId}
     * @allow (get, create, update, delete): The user with ID {userId} can perform these operations on their own order items.
     * @deny (get, create, update, delete): A user cannot access or modify another user's order items.
     * @principle Enforces user-ownership for order items.
     */
    match /users/{userId}/orders/{orderId}/orderItems/{orderItemId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows a user to read, create, update, and delete their own cart items.
     * @path /users/{userId}/cartItems/{cartItemId}
     * @allow (get, create, update, delete): The user with ID {userId} can perform these operations on their own cart items.
     * @deny (get, create, update, delete): A user cannot access or modify another user's cart items.
     * @principle Enforces user-ownership for cart items.
     */
    match /users/{userId}/cartItems/{cartItemId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows read access to promotional banner information.
     * @path /promoBanners/{promoBannerId}
     * @allow (get, list): Any user can read promotional banner information.
     * @deny (create, update, delete): No user can create, update, or delete promotional banner information through the client.
     * @principle Public read access for promotional banner information.
     */
    match /promoBanners/{promoBannerId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows read access to featured product information.
     * @path /featuredProducts/{featuredProductId}
     * @allow (get, list): Any user can read featured product information.
     * @deny (create, update, delete): No user can create, update, or delete featured product information through the client.
     * @principle Public read access for featured product information.
     */
    match /featuredProducts/{featuredProductId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows a user to read, create, update, and delete their own wishlist items.
     * @path /users/{userId}/wishlistItems/{wishlistItemId}
     * @allow (get, create, update, delete): The user with ID {userId} can perform these operations on their own wishlist items.
     * @deny (get, create, update, delete): A user cannot access or modify another user's wishlist items.
     * @principle Enforces user-ownership for wishlist items.
     */
    match /users/{userId}/wishlistItems/{wishlistItemId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows read access to AI-generated product recommendations.
     * @path /aiRecommendations/{aiRecommendationId}
     * @allow (get, list): Any user can read AI recommendations.
     * @deny (create, update, delete): No user can create, update, or delete AI recommendations through the client.
     * @principle Public read access for AI recommendations.
     */
    match /aiRecommendations/{aiRecommendationId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return isSignedIn() && request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
  }
}